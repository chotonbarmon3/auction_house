# Copy this file to .env and adjust if needed.

# Local Postgres with no password (trust auth on localhost).
# Format: postgresql+asyncpg://<user>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/auction_house

# Secret used to sign JWT tokens. Change this to any random string.
JWT_SECRET=long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# One-time code required to register as an admin (keep this private).
ADMIN_SIGNUP_CODE=give admin code
